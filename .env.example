# Only needed for a production deploy with docker-compose.prod.yml
# (Caddy + HTTPS). Local dev (`docker compose up`) doesn't read this at
# all — the defaults baked into docker-compose.yml are enough.
#
#   cp .env.example .env
#   # then set DOMAIN below and run:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Your real domain, no scheme/protocol (e.g. evades.example.org). Used
# by Caddy to request a Let's Encrypt cert, and by the api container to
# set CORS_ORIGINS=https://$DOMAIN.
DOMAIN=
