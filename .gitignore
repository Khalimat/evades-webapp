# OS cruft
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Env / secrets — never commit real credentials
.env
.env.*
!.env.example

# Generated / downloaded scientific data — large binary artifacts that
# are built locally per data/README.md, not source code. Keep the
# directory structure (via .gitkeep) but not the contents.
data/hmm/*
!data/hmm/.gitkeep
data/foldseek/*
!data/foldseek/.gitkeep
data/foldseek_monomer_structures/*
!data/foldseek_monomer_structures/.gitkeep
data/downloads/*
!data/downloads/.gitkeep
data/uploads/*
!data/uploads/.gitkeep

# Explore tab — statically rendered by generator/export_static.py.
# Same story as data/*: a generated artifact, not source. Regenerate
# per generator/README.md rather than committing it.
frontend/explore/*
!frontend/explore/.gitkeep

# Editors
.vscode/
.idea/

# Explorer static-site generator (one-time/occasional use, not part of
# the deployed app) — see generator/README.md. Heavy inputs and local
# tooling live here but never get committed.
generator/assets/
generator/tools/
generator/.venv/
generator/work/
generator/results/
generator/*.sqlite3
generator/website/anti_defence/*.sqlite3
generator/website/anti_defence/staticfiles/
generator/website/requirements.txt.original
.nextflow*
anti_defence-main.zip

# pytest scratch (conftest.py points UPLOAD_DIR here)
backend/tests/_uploads/
